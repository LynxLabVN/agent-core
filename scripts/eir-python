#!/usr/bin/env bash
# Run Python in this checkout's environment: `scripts/eir-python ARGS...`.
#
# A GitHub Actions job runs the interpreter setup-pm exported as EIR_PYTHON,
# so a recipe never re-runs setup on a runner. Anywhere else EIR_PYTHON may
# be inherited from a wrapped `eir` (a release venv without the dev tools),
# so scripts/run-in-eir-env applies (and if stale, syncs) the environment
# `source ./activate` gives a shell.
set -euo pipefail

if [ "${GITHUB_ACTIONS:-}" = true ] && [ -z "${__EIR_ACTIVATED:-}" ] && [ -n "${EIR_PYTHON:-}" ] \
    && [ -x "$EIR_PYTHON" ]; then
    exec "$EIR_PYTHON" "$@"
fi
exec "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/run-in-eir-env" python "$@"
