#!/usr/bin/env bash
# ============================================================================
# venv-style activation of the Eir dev environment for an interactive shell.
#
#   source ./activate       (bash / zsh, repo root)
#   source ./activate.fish  (fish)
#   .\activate.ps1          (PowerShell)
#
# Applies the composed pm env (PATH + tool vars) to the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `eir` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Scripts and other processes do not source this: they run under
# `scripts/run-in-eir-env`. Both build on scripts/_activation.sh.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `eir pm
# install` and `eir update` keep that check.
# ============================================================================
_EIR_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_eir_test_env="--test-environment"
_eir_expect_extras=""
for _eir_arg in "$@"; do
    if [ -n "$_eir_expect_extras" ]; then
        _eir_test_env="--test-environment=$_eir_arg"
        _eir_expect_extras=""
        continue
    fi
    case "$_eir_arg" in
        --) break ;;
        --test-extras) _eir_expect_extras=1 ;;
        --test-extras=*) _eir_test_env="--test-environment=${_eir_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_eir_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _eir_arg _eir_test_env _eir_expect_extras
    return 2 2>/dev/null || exit 2
fi
unset _eir_arg _eir_expect_extras

# shellcheck source=scripts/_activation.sh
. "$_EIR_REPO/scripts/_activation.sh"

if ! eir_sync "$_EIR_REPO" "$_eir_test_env"; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _eir_test_env
    return 1 2>/dev/null || exit 1
fi
unset _eir_test_env

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __EIR_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

_eir_script="$(eir_compose_env "$_EIR_REPO" sh)" || {
    echo "activate: could not compose the environment (see above)" >&2
    unset _eir_script
    return 1 2>/dev/null || exit 1
}
_eir_keys="$(printf '%s\n' "$_eir_script" | sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')"

# --- snapshot what we are about to change (deactivate restores this) ---
# __EIR_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__EIR_SAVED_PATH="$PATH"
for _eir_k in $_eir_keys; do
    eval "__EIR_SAVED_$_eir_k=\"\${$_eir_k+set}\""
    eval "__EIR_PRIOR_$_eir_k=\${$_eir_k-__EIR_UNSET__}"
done
eir_apply_env "$_eir_script"

# This checkout, not whichever `eir` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__EIR_WORKTREE="$_EIR_REPO"
# The branch names the worktree. A checkout cannot share a branch with another.
__EIR_WORKTREE_NAME="$(git -C "$_EIR_REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__EIR_WORKTREE_NAME" ] || [ "$__EIR_WORKTREE_NAME" = HEAD ]; then
    __EIR_WORKTREE_NAME="$(basename "$_EIR_REPO")"
fi
__EIR_SAVED_PS1="${PS1-__EIR_UNSET__}"
__EIR_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__EIR_UNSET__}"

_eir_worktree_here() {
    _eir_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_eir_top" && pwd -P)" = "$(cd "$__EIR_WORKTREE" && pwd -P)" ]
}

eir() {
    _eir_worktree_here || {
        printf '%s\n' "eir: $(pwd) is outside $__EIR_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__EIR_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" eir "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe eir "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python eir "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe eir "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python eir "$@"
        else
            exec python eir "$@"
        fi
    )
}

_eir_prompt() {
    if [ "$__EIR_SAVED_PS1" = "__EIR_UNSET__" ]; then
        _eir_base_ps1=""
    else
        _eir_base_ps1="$__EIR_SAVED_PS1"
    fi
    if _eir_worktree_here; then
        PS1="($__EIR_WORKTREE_NAME) $_eir_base_ps1"
    else
        PS1="$_eir_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_eir_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_eir_prompt
fi
_eir_prompt

deactivate() {
    export PATH="$__EIR_SAVED_PATH"
    for _eir_k in $__EIR_KEY_LIST; do
        eval "_eir_was=\"\$__EIR_SAVED_$_eir_k\""
        eval "_eir_old=\"\$__EIR_PRIOR_$_eir_k\""
        if [ "$_eir_was" != "set" ]; then
            unset "$_eir_k"
        else
            export "$_eir_k=$_eir_old"
        fi
        unset "__EIR_SAVED_$_eir_k" "__EIR_PRIOR_$_eir_k"
    done
    if [ "$__EIR_SAVED_PS1" = "__EIR_UNSET__" ]; then
        unset PS1
    else
        PS1="$__EIR_SAVED_PS1"
    fi
    if [ "$__EIR_SAVED_PROMPT_COMMAND" = "__EIR_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__EIR_SAVED_PROMPT_COMMAND"
    fi
    unset __EIR_SAVED_PATH __EIR_KEY_LIST __EIR_ACTIVATED \
          __EIR_WORKTREE __EIR_WORKTREE_NAME \
          __EIR_SAVED_PS1 __EIR_SAVED_PROMPT_COMMAND
    unset -f deactivate eir _eir_worktree_here _eir_prompt
    unset _eir_k _eir_was _eir_old _eir_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__EIR_KEY_LIST="$_eir_keys"

# The composition library is not part of the user's shell.
unset -f eir_sync eir_bootstrap_python eir_compose_env eir_apply_env \
         eir_activation_current eir_ensure_env
unset _EIR_REPO _eir_script _eir_keys _eir_k _eir_top
